{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch index.ts",
    "dev:worker": "bun run --watch printerWorker.ts",
    "start": "bun run start.ts",
    "start:server": "bun run index.ts",
    "start:worker": "bun run printerWorker.ts",
    "build:frontend": "cd ../frontend && bun run build",
    "prod": "cd ../frontend && bun run build && cd ../backend && bun run start.ts",
    "test-printer": "bun run testPrinter.ts",
    "test-printer:counter": "bun run testPrinter.ts counter",
    "test-printer:kitchen": "bun run testPrinter.ts kitchen",
    "seed": "bun run prisma/seed.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "node-thermal-printer": "^4.6.0",
    "pg": "^8.21.0"
  }
}
